      "name": "Archetype of Aggression",
      "url": "https://api.scryfall.com/cards/named?exact=Archetype%20of%20Aggression",
      "scryfall_uri": "https://scryfall.com/card/bng/88/archetype-of-aggression?utm_source=api",
      "rulings_uri": "https://api.scryfall.com/cards/13946413-c76d-41a8-a699-404fd56b2067/rulings",
      "retrieved_utc": "2026-11-13T15:28:12.304658+00:00",
      "response_sha256": "8efca8de62bde5a7680f46b2278c42ad38398a82ffa9b62ee3c7536cf39575e5",
      "local_mismatches": [],
      "oracle": {
        "name": "Archetype of Aggression",
        "oracle_text": "Creatures you control have trample.\nCreatures your opponents control lose trample and can't have or gain trample.",
        "type_line": "Enchantment Creature — Human Warrior",
        "power": "3",
        "toughness": "2",
        "colors": [
          "R"
        ]
      },
      "rulings": {
        "retrieved_utc": "2026-11-13T15:31:28.542224+00:00",
        "response_sha256": "81867bbf7aa8a0ff5ab4323cef980556c513a56ad86dbeebea70796da7cfbb3c",
        "records": [
          {
            "object": "ruling",
            "oracle_id": "263408e6-b315-4af5-8cb8-3fd1aa88e48c",
            "source": "wotc",
            "published_at": "2014-02-01",
            "comment": "The Archetype’s second ability applies to each creature controlled by any of your opponents, no matter when it entered the battlefield."
          },
          {
            "object": "ruling",
            "oracle_id": "263408e6-b315-4af5-8cb8-3fd1aa88e48c",
            "source": "wotc",
            "published_at": "2014-02-01",
            "comment": "While you control an Archetype, continuous effects generated by the resolution of spells and abilities that would give the specified ability to creatures your opponents control aren’t created. For example, if you control Archetype of Courage, a spell cast by an opponent that gives creatures they control first strike wouldn’t cause the creatures to have first strike, even if later in the turn Archetype of Courage left the battlefield. (If the spell has additional effects, such as raising the power of the creatures, those effects will apply as normal.)"
          },
          {
            "object": "ruling",
            "oracle_id": "263408e6-b315-4af5-8cb8-3fd1aa88e48c",
            "source": "wotc",
            "published_at": "2014-02-01",
            "comment": "Conversely, continuous effects generated by static abilities (such as an Aura that granted the appropriate ability) would resume applying if the Archetype left the battlefield."
          },
          {
            "object": "ruling",
            "oracle_id": "263408e6-b315-4af5-8cb8-3fd1aa88e48c",
            "source": "wotc",
            "published_at": "2014-02-01",
            "comment": "If you and an opponent each control the same Archetype, no creature controlled by any player will have the appropriate ability."
          }
        ]
      }
    },
